# Local Docker PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_USER=consumer_admin
POSTGRES_PASSWORD=change_this_local_password
POSTGRES_DB=consumeralpha
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer

# SQLAlchemy connection used by ingestion and modelling
DATABASE_URL=postgresql://consumer_admin:change_this_local_password@localhost:5432/consumeralpha

# FRED API key
FRED_API_KEY=your_fred_api_key_here
